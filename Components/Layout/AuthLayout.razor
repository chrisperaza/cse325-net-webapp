@inherits LayoutComponentBase

<main class="auth-shell">
    <section class="auth-intro" aria-label="Appointment Book">
        <a class="auth-brand" href="/" aria-label="Appointment Book home">
            <span class="brand-mark" aria-hidden="true">A</span>
            <span>Appointment Book</span>
        </a>

        <div class="intro-copy">
            <p class="eyebrow">A clearer kind of calendar</p>
            <h1>Make room for what matters.</h1>
            <p class="intro-description">Keep the details close, and your day a little easier to manage.</p>

            <div class="appointment-preview" aria-label="Example upcoming appointment">
                <div class="preview-date">
                    <span>THU</span>
                    <strong>18</strong>
                </div>
                <div class="preview-details">
                    <span class="preview-label">UP NEXT</span>
                    <strong>Lunch with Maya</strong>
                    <span>12:30 PM <span aria-hidden="true">·</span> Juniper Cafe</span>
                </div>
                <span class="preview-dot" aria-hidden="true"></span>
            </div>
        </div>

        <p class="intro-footer">Your plans, all in one place.</p>
    </section>

    <section class="auth-main">
        <div class="auth-content">
            @Body
        </div>
    </section>
</main>